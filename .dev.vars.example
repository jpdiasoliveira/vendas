# Variáveis de ambiente do Worker em desenvolvimento.
# Copie para .dev.vars e preencha os valores (não commite .dev.vars).
#
# Stack de dados: Supabase (PostgreSQL). O Worker não usa D1/R2 neste projeto.
#
# Para o login do painel admin (POST /api/login) funcionar, defina:
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Outras variáveis usadas pelo Worker (ajuste conforme seu projeto):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# MOCHA_USERS_SERVICE_API_URL=
# MOCHA_USERS_SERVICE_API_KEY=
# MERCADO_PAGO_ACCESS_TOKEN=
# Secret de assinatura dos webhooks (Suas integrações > Webhooks) — recomendado em produção
# MERCADO_PAGO_WEBHOOK_SECRET=
# Produção SaaS: true + secret obrigatórios. Dev: false ou omitido permite webhook sem assinatura
# REQUIRE_MP_WEBHOOK_SECRET=false
# CORS: origens permitidas separadas por vírgula (não use *)
# CORS_ORIGIN=http://localhost:5173,https://seu-dominio.com
#
# URL da vitrine (Checkout Pro: back_urls). Se omitido, o Worker usa o header Origin na criação da preferência.
# STOREFRONT_BASE_URL=http://localhost:5173
#
# Plataforma SaaS — POST /api/platform/stores (criar loja sem SQL):
# PLATFORM_OPERATOR_EMAILS=operador@empresa.com,joao@empresa.com
# Opcional: exige header x-platform-create-store-secret (defina o mesmo no front: VITE_PLATFORM_CREATE_STORE_SECRET)
# PLATFORM_CREATE_STORE_SECRET=seu-segredo-demo
#
# Vitrine (Vite): mesmo e-mail da lista acima para exibir o menu «Plataforma» no admin
# VITE_PLATFORM_OPERATOR_EMAILS=operador@empresa.com,joao@empresa.com
# VITE_PLATFORM_CREATE_STORE_SECRET=seu-segredo-demo
#
# Vite (.env ou .env.local na raiz do repo — não é .dev.vars): em http://localhost:5173 sem subdomínio,
# define a loja usada em x-store-slug (evita 404 em /api/store/settings):
# VITE_DEFAULT_STORE_SLUG=natfoods
